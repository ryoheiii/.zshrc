#!/bin/zsh
# 設定はこの 1 ファイルで管理する。操作と導入方法は README.md を参照。

################
### 環境変数 ###
################
# PATH 上の実行ファイルを調べる。WSL の Windows 側の探索は遅いため省く。
function __zshrc_has() {
    local d
    for d in ${path:#/mnt/[a-z]/*}; do
        if [[ -f $d/$1 && -x $d/$1 ]]; then
            return 0
        fi
    done
    return 1
}

# PATH の重複を除き、先頭のものを優先する。
typeset -gU path PATH

# ユーザーが導入したコマンドを優先する。
export PATH="$HOME/.local/bin:$PATH"

### カスタムインストール先
# fzf は公式配布版を OS 同梱版より優先する。
if [ -d "$HOME/.fzf/bin" ]; then
    export PATH="$HOME/.fzf/bin:$PATH"
fi

# fnm の公式インストーラーの既定の導入先。
if [ -d "$HOME/.local/share/fnm" ]; then
    export PATH="$HOME/.local/share/fnm:$PATH"
fi

# Node.js は非対話で明示的に source する場合にも利用できるようにする。
if __zshrc_has fnm; then
    eval "$(fnm env --shell zsh)"
fi

# エディターが未指定なら、導入済みの emacsclient を使う。
if [[ -z $EDITOR ]] && __zshrc_has emacsclient; then
    export EDITOR="emacsclient -nw -a ''"
fi

# 非対話で明示的に source する場合は、環境変数と PATH だけ設定する。
[[ -o interactive ]] || return 0


################
### 基本設定 ###
################
# 補完・履歴・emacs 形式のキー操作を Oh My Zsh に任せる。更新は setup.sh update で行う。
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
ZSH_COMPDUMP="${ZDOTDIR:-$HOME}/.zcompdump"
zstyle ':omz:update' mode disabled
# 引数まで展開するディレクトリ alias は使わず、必要な短縮だけを alias 節で定義する。
zstyle ':omz:lib:directories' aliases no
# 端末タイトルとプロンプトはそれぞれ端末・Starship に任せる。
DISABLE_AUTO_TITLE=true
ZSH_THEME=""
# Git の短縮操作と、行編集できる端末での入力支援だけを読み込む。
plugins=()
if __zshrc_has git; then
    plugins+=(git)
fi
if [[ -o zle && -t 0 && -t 1 && $TERM != dumb ]]; then
    if __zshrc_has fzf; then
        plugins+=(fzf)
    fi
    if __zshrc_has zoxide; then
        plugins+=(zoxide)
    fi
    if [ -f "$ZSH/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh" ]; then
        plugins+=(zsh-autosuggestions)
    fi
    # 色分けは他のプラグインより後に読み込む。
    if [ -f "$ZSH/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh" ]; then
        plugins+=(zsh-syntax-highlighting)
    fi
fi
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    # 再読み込みでフックや widget を重ねない。追加した補完だけは再走査する。
    if (( ! $+functions[omz] )); then
        source "$ZSH/oh-my-zsh.sh"
    else
        compinit -i -d "$ZSH_COMPDUMP"
    fi
else
    # 未導入でも静かに起動し、標準の補完と履歴を使えるようにする。
    autoload -Uz compinit
    compinit
    bindkey -e
    setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus interactive_comments
    setopt share_history hist_ignore_dups hist_ignore_space hist_verify hist_expire_dups_first
fi
# 保存・検索時の重複を省き、ディレクトリスタックの表示とビープ音を抑える。
setopt hist_save_no_dups hist_find_no_dups pushd_silent
unsetopt beep correct correct_all


##################
### プロンプト ###
##################
# 行編集できる端末では Starship を使い、再読み込みでは widget を初期化し直さない。
if [[ $TERM != dumb && -o zle && -t 0 && -t 1 ]] && __zshrc_has starship; then
    # 専用フォント不要の表示を使う。個人設定は STARSHIP_CONFIG で指定できる。
    export STARSHIP_CONFIG="${STARSHIP_CONFIG:-${${(%):-%x}:A:h}/starship.toml}"
    if (( ! $+functions[prompt_starship_precmd] )); then
        eval "$(starship init zsh)"
    fi
else
    # Starship がない環境でも現在地と終了状態を表示する。
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})%#%f '
    RPROMPT=''
    if [[ $TERM == dumb ]]; then
        PROMPT='%n@%m:%~ %# '
    fi
fi


##################
### シェル変数 ###
##################
# 履歴は最大 10,000 件を保存し、メモリ上には重複整理の余裕を持たせる。
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000


############
### 関数 ###
############
# 引数なしなら親へ、名前を指定するとカレントを含む最寄りの同名の上位ディレクトリへ移動する。
function up() {
    if (( $# == 0 )); then
        cd ..
        return
    fi
    if (( $# != 1 )) || [[ -z $1 || $1 == */* ]]; then
        print -u2 '使い方: up [ディレクトリ名]'
        return 1
    fi
    local p="$PWD/" to
    to=${p%"/$1/"*}
    if [[ $to == "$p" ]]; then
        print -ru2 -- "no such file or directory: $1"
        return 1
    fi
    cd -- "$to/$1"
}



#############
### alias ###
#############
# 設定を再読み込みする。ツールの更新や定義の削除後は exec zsh で起動し直す。
alias zns='source "${ZDOTDIR:-$HOME}/.zshrc"'

# Emacs は実行ファイルがある場合だけ短縮する。必要ならデーモンも起動する。
if __zshrc_has emacs; then
    alias e='emacs -nw'
fi
if __zshrc_has emacsclient; then
    alias ecli="emacsclient -nw -a ''"
fi

# Linux の一覧に色とファイル種別を付ける。
case ${OSTYPE} in
    linux*)
        alias ls='ls -F --color=auto'
        ;;
esac
# 一覧表示と親ディレクトリへの移動を短縮する。Git の alias は Oh My Zsh の定義を使う。
alias la='ls -A'
alias ll='ls -lh'
alias lla='ls -lhA'
alias ..='cd ..'

# 対話でのコピー・移動・リンク作成は、既存ファイルの上書きを確認する。
alias cp='cp -i'
alias mv='mv -i'
alias ln='ln -i'


####################
### キーバインド ###
####################
# Oh My Zsh の端末判定に加え、Home / End の通常モードのシーケンスにも対応する。
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line


##################
### 補完ルール ###
##################
# alias を展開して補完する。説明とグループを付け、候補を矢印で選択する。
unsetopt complete_aliases menu_complete
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'


##############
### その他 ###
##############
### WSL
# OS・SSH が設定した DISPLAY、ロケール、umask を保つ。X の認証ファイルだけ未指定時に補う。
if [[ -n $WSL_DISTRO_NAME || ( -r /proc/sys/kernel/osrelease && "$(</proc/sys/kernel/osrelease)" == *[Mm]icrosoft* ) ]]; then
    if [[ -z $XAUTHORITY ]] && [ -f "$HOME/.Xauthority" ]; then
        export XAUTHORITY="$HOME/.Xauthority"
    fi
fi
