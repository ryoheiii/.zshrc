## emacs (emacs がある場合だけ。alias 節の erestart が使う)
if __zshrc_has emacs; then
    function estart() {
      if ! emacsclient -e 0 > /dev/null 2>&1; then
        ({
          cd
          emacs --daemon
          cd -
        } > /dev/null 2>&1 & )
      fi
    }
    # estart # シェル起動時にEmacsデーモンも起動する
fi

### WSL
# WSL のときだけ設定する (wsl.exe から起動したシェルは WSL_DISTRO_NAME を持つ。ssh などで持たないときはカーネル名で判定する)
if [[ -n $WSL_DISTRO_NAME || ( -r /proc/sys/kernel/osrelease && "$(</proc/sys/kernel/osrelease)" == *[Mm]icrosoft* ) ]]; then
    umask 022

    ## X サーバーの表示先 (WSLg)
    export DISPLAY=:0

    export LC_ALL=ja_JP.UTF-8
    # X の認証ファイル (ある場合だけ)
    if [ -f "$HOME/.Xauthority" ]; then
        export XAUTHORITY="$HOME/.Xauthority"
    fi
fi

## nvm (~/.nvm/nvm.sh がある場合だけ。bash_completion は compinit を使うので補完ルール節より後に置く)
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
fi

# PATH の重複を除く (重複したパスは最初に出てきた位置に残る)
typeset -U path PATH
