#!/bin/zsh
# 共通設定を管理し、PC 固有の設定は同じディレクトリのローカルファイルから読み込む。
# 環境変数と PATH を設定した後、対話シェルでだけ基本設定以降を読み込む。

################
### 環境変数 ###
################
# コマンドの有無を PATH 上の実行ファイルで調べる。遅い Windows ドライブの探索は省く。
function __zshrc_has() {
    local d
    for d in ${path:#/mnt/[a-z]/*}; do
        if [[ -f $d/$1 && -x $d/$1 ]]; then
            return 0
        fi
    done
    return 1
}

# PATH を変更する前に重複排除を有効にし、同じパスは先頭のものを残す。
typeset -gU path PATH

### カスタムインストール先
# PATH の先頭へ順に追加するため、後の設定ほど優先する。
# 個人用コマンドをシステムのコマンドより優先する。
export PATH="$HOME/.local/bin:$PATH"

# fzf の公式配布版を OS 同梱版より優先する。
if [ -d "$HOME/.fzf/bin" ]; then
    export PATH="$HOME/.fzf/bin:$PATH"
fi

# 公式インストーラーで導入した fnm を使えるようにする。
if [ -d "$HOME/.local/share/fnm" ]; then
    export PATH="$HOME/.local/share/fnm:$PATH"
fi

# PC 固有の環境変数と PATH を、symlink 解決後の配置先からツールの初期化前に読み込む。
if [ -f "${${(%):-%x}:A:h}/_zshrc.env.local" ]; then
    if ! source "${${(%):-%x}:A:h}/_zshrc.env.local"; then
        print -u2 '警告: _zshrc.env.local の読み込みが失敗しました。'
    fi
fi

### ツールの環境設定
# fnm を初期化し、選択した Node.js を PATH の先頭に置く。
if __zshrc_has fnm; then
    () {
        local init
        # シェルごとに一度だけ初期化する。失敗した場合は次の読み込みで再試行する。
        if [[ ${__zshrc_fnm_pid:-} != $$ ]]; then
            if init=$(fnm env --shell zsh) && eval "$init"; then
                typeset -g __zshrc_fnm_pid=$$
            fi
        elif [[ -n $FNM_MULTISHELL_PATH ]]; then
            # 再読み込みでは選択中のバージョンを保ち、その PATH を先頭へ戻す。
            export PATH="$FNM_MULTISHELL_PATH/bin:$PATH"
        fi
    }
fi

# エディターが未指定なら Emacs を使い、必要に応じてデーモンも起動する。
if [[ -z $EDITOR ]] && __zshrc_has emacsclient; then
    export EDITOR="emacsclient -nw -a ''"
fi

# fzf の画面（Ctrl+R、Tab 補完、zi など）の表示が未指定なら、端末設定で幅が変わる罫線や記号を使わず ASCII にする。
# 表示用のオプションだけを置く（--height や --bind は Tab 補完の動作を変えるため）。
if [[ -z $FZF_DEFAULT_OPTS ]] && __zshrc_has fzf; then
    export FZF_DEFAULT_OPTS='--no-unicode'
fi

# 非対話シェルから明示的に source した場合は、ここで正常終了する。
[[ -o interactive ]] || return 0


################
### 基本設定 ###
################
### Oh My Zsh
# 未指定なら標準の導入先を使う。
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
# 補完キャッシュを OS 側と分け、補完数の違いによる毎回の再生成を防ぐ。
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump"
# 起動時の自動更新を止め、bash setup.sh update で更新する。
zstyle ':omz:update' mode disabled
# 引数まで展開するディレクトリ alias を無効にし、短縮操作は alias 節へまとめる。
zstyle ':omz:lib:directories' aliases no
# 端末タイトルを上書きしない。プロンプトは後の節で設定するため、テーマも読み込まない。
DISABLE_AUTO_TITLE=true
ZSH_THEME=""

### プラグイン
# 再読み込みではプラグインの一覧・フック・widget を作り直さない。
if [ -f "$ZSH/oh-my-zsh.sh" ] && (( ! $+functions[omz] )); then
    # 利用できるプラグインを読み込み順に並べる。
    plugins=()

    # gst・gd・gco など、Git 操作の短縮を使う。
    if __zshrc_has git && [ -f "$ZSH/plugins/git/git.plugin.zsh" ]; then
        plugins+=(git)
    fi
    # アーカイブの形式に応じた展開コマンドを使う。
    if [ -f "$ZSH/plugins/extract/extract.plugin.zsh" ]; then
        plugins+=(extract)
    fi
    # ファイルやディレクトリの絶対パスをクリップボードへコピーする。
    if [ -f "$ZSH/plugins/copypath/copypath.plugin.zsh" ]; then
        plugins+=(copypath)
    fi
    # VS Code が利用できる場合だけ、起動・差分・行指定の短縮を追加する。
    if __zshrc_has code && [ -f "$ZSH/plugins/vscode/vscode.plugin.zsh" ]; then
        VSCODE=code
        plugins+=(vscode)
    fi

    # 入力支援は行編集できる端末だけで使う。
    if [[ -o zle && -t 0 && -t 1 && $TERM != dumb ]]; then
        # Esc を2回押すと、入力中のコマンドへ sudo を付ける。
        if __zshrc_has sudo && [ -f "$ZSH/plugins/sudo/sudo.plugin.zsh" ]; then
            plugins+=(sudo)
        fi
        # 履歴・ファイル・ディレクトリを絞り込んで選択する。
        if __zshrc_has fzf && [ -f "$ZSH/plugins/fzf/fzf.plugin.zsh" ]; then
            plugins+=(fzf)
            # Tab 補完の検索は fzf の後、入力候補と構文色分けの前に読み込む。
            if [ -f "${ZSH_CUSTOM:-$ZSH/custom}/plugins/fzf-tab/fzf-tab.plugin.zsh" ]; then
                plugins+=(fzf-tab)
            fi
        fi
        # 訪問履歴から z / zi でディレクトリへ移動する。
        if __zshrc_has zoxide && [ -f "$ZSH/plugins/zoxide/zoxide.plugin.zsh" ]; then
            plugins+=(zoxide)
        fi
        # 入力中のコマンドに続く候補を薄く表示する。
        if [ -f "$ZSH/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh" ]; then
            plugins+=(zsh-autosuggestions)
        fi
        # 構文色分けは、他のプラグインが登録したキー操作にも適用するため最後に読み込む。
        if [ -f "$ZSH/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh" ]; then
            plugins+=(zsh-syntax-highlighting)
        fi
    fi

    # 確定した一覧で、補完とプラグインを初期化する。
    source "$ZSH/oh-my-zsh.sh"
fi

### シェルオプション
# ディレクトリ名だけで移動し、移動履歴の重複と毎回の表示を省く。
setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus pushd_silent

# 履歴をシェル間で共有し、先頭が空白の入力と保存・検索時の重複を省く。
setopt share_history hist_ignore_dups hist_ignore_space hist_expire_dups_first
setopt hist_save_no_dups hist_find_no_dups
# !! などの履歴展開は、編集画面で確認してから実行する。
setopt hist_verify

# 対話中もコメントを使い、ビープ音と自動修正を無効にする。
setopt interactive_comments
unsetopt beep correct correct_all


##################
### プロンプト ###
##################
# 行編集できる端末では Starship で現在地・Git の状態・終了コードを表示する。
if [[ $TERM != dumb && -o zle && -t 0 && -t 1 ]] && __zshrc_has starship; then
    # 未指定なら、この設定ファイルと同じ場所の starship.toml を使う。
    export STARSHIP_CONFIG="${STARSHIP_CONFIG:-${${(%):-%x}:A:h}/starship.toml}"
    # 再読み込みではフックやキー操作を初期化し直さない。
    if (( ! $+functions[prompt_starship_precmd] )); then
        eval "$(starship init zsh)"
    fi
else
    # Starship を使わない環境では、現在地と終了状態の色を標準プロンプトで表示する。
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})%#%f '
    RPROMPT=''
    # 色を扱えない端末では装飾を付けない。
    if [[ $TERM == dumb ]]; then
        PROMPT='%n@%m:%~ %# '
    fi
fi


##################
### シェル変数 ###
##################
# 履歴は最大 10,000 件を保存し、メモリ上には重複整理の余裕を持たせる。
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000


############
### 関数 ###
############
# 引数なしなら親へ移動する。
# 名前を指定すると、現在地を含めて最も近い同名の上位ディレクトリへ移動する。
function up() {
    if (( $# == 0 )); then
        cd ..
        return
    fi
    if (( $# != 1 )) || [[ -z $1 || $1 == */* ]]; then
        print -u2 '使い方: up [ディレクトリ名]'
        return 1
    fi
    local current_path="$PWD/" target
    # 名前が一致する最短の末尾部分を除き、最も近い同名ディレクトリを選ぶ。
    target=${current_path%"/$1/"*}
    if [[ $target == "$current_path" ]]; then
        print -ru2 -- "no such file or directory: $1"
        return 1
    fi
    cd -- "$target/$1"
}


#############
### alias ###
#############
# 設定を再読み込みする。ツールの更新や定義の削除後は exec zsh で起動し直す。
alias zns='source "${ZDOTDIR:-$HOME}/.zshrc"'

# 親ディレクトリへの移動を短縮する。
alias ..='cd ..'

# Linux の一覧に色とファイル種別を付ける。
case ${OSTYPE} in
    linux*)
        alias ls='ls -F --color=auto'
        ;;
esac
# 詳細一覧と、隠しファイルを含む一覧を短縮する。
alias la='ls -A'
alias ll='ls -lh'
alias lla='ls -lhA'

# 対話でのコピー・移動・リンク作成は、既存ファイルの上書きを確認する。
alias cp='cp -i'
alias mv='mv -i'
alias ln='ln -i'

# Emacs を端末内で開く。
if __zshrc_has emacs; then
    alias e='emacs -nw'
fi
# Emacs のデーモンへ接続し、未起動なら起動する。
if __zshrc_has emacsclient; then
    alias ecli="emacsclient -nw -a ''"
fi


####################
### キーバインド ###
####################
# EDITOR の種類や Oh My Zsh の有無によらず、emacs 形式のキー操作を使う。
bindkey -e
# Home / End は、端末の通常モードのシーケンスでも行頭・行末へ移動する。
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

# Oh My Zsh の履歴検索が使える場合、Ctrl+p / Ctrl+n を ↑ / ↓ と同じ操作にする。
# Shift は不要。未導入時は emacs キーマップの通常の履歴移動を使う。
if (( $+widgets[up-line-or-beginning-search] && $+widgets[down-line-or-beginning-search] )); then
    bindkey '^P' up-line-or-beginning-search
    bindkey '^N' down-line-or-beginning-search
fi


##################
### 補完ルール ###
##################
# 未初期化のときだけ標準補完を読み込み、追加済みの登録を保つ。
if (( ! $+functions[compdef] )); then
    autoload -Uz compinit
    compinit
fi
# alias の展開先を補完し、最初の候補を自動では選ばない。
unsetopt complete_aliases menu_complete

# 補完候補を種類ごとにまとめ、選択用メニューを使えるようにする。
zmodload zsh/complist
zstyle ':completion:*' group-name ''

# 候補の色は ls と同じ LS_COLORS に揃え、後の節やローカル設定で変えた値も補完のたびに反映する。
# LS_COLORS が無い環境では空文字 1 つを返し、zsh 組み込みの ls 既定色を使う。
zstyle -e ':completion:*' list-colors 'reply=("${(@s.:.)LS_COLORS}")'
zstyle ':completion:*:descriptions' format '[%d]'

# fzf-tab があれば検索画面で選び、なければ矢印キーで標準メニューを操作する。
if (( $+functions[fzf-tab-complete] )); then
    zstyle ':completion:*' menu no
    # FZF_DEFAULT_OPTS の表示設定を Tab 補完にも使う。
    zstyle ':fzf-tab:*' use-fzf-default-opts yes
    # グループの目印には、端末設定で幅が変わる「·」を使わない。
    zstyle ':fzf-tab:*' prefix ''
    # < と > でグループを切り替える。既定の F1 / F2 は VS Code などが横取りする。
    zstyle ':fzf-tab:*' switch-group '<' '>'
    # cd の候補では、選択中のディレクトリの内容を右半分に表示する。移動履歴などパスでない候補には出さず、
    # 端末の幅が 60 桁未満なら候補の表示幅を優先して隠す。
    zstyle ':fzf-tab:complete:cd:*' fzf-preview '[[ -d $realpath ]] && ls -1 --color=always -- $realpath'
    zstyle ':fzf-tab:complete:cd:*' fzf-flags '--preview-window=right,50%,<30(hidden)'
else
    zstyle ':completion:*' menu select
fi


##############
### その他 ###
##############
### WSL
# WSL で X 認証ファイルが存在する場合、未指定の XAUTHORITY を補う。
if [[ -n $WSL_DISTRO_NAME || ( -r /proc/sys/kernel/osrelease && "$(</proc/sys/kernel/osrelease)" == *[Mm]icrosoft* ) ]]; then
    if [[ -z $XAUTHORITY ]] && [ -f "$HOME/.Xauthority" ]; then
        export XAUTHORITY="$HOME/.Xauthority"
    fi
    # /mnt 配下は他ユーザー書き込み可（ow）の扱いになり、ls と補完候補のディレクトリ名に緑の背景が付くため、
    # 通常のディレクトリ（di）と同じ配色にする。同じキーが重複すると ls と補完で採用順が異なるので、
    # 既存の ow= を除いてから付け、再読み込みしても増やさない。
    if [[ -n $LS_COLORS ]]; then
        () {
            local -a colors=(${(s.:.)LS_COLORS})
            local -a dir_entries=(${(M)colors:#di=*})
            # di の指定があればその値（空の無装飾指定を含む）を使い、無ければ dircolors 既定のディレクトリ色にする。
            local ow_color='01;34'
            if (( $#dir_entries )); then
                ow_color=${dir_entries[1]#di=}
            fi
            colors=(${colors:#ow=*} "ow=$ow_color")
            export LS_COLORS=${(j.:.)colors}
        }
    fi
fi

# PC 固有の alias・関数などを最後に読み込み、共通設定を上書きできるようにする。
if [ -f "${${(%):-%x}:A:h}/_zshrc.local" ]; then
    if ! source "${${(%):-%x}:A:h}/_zshrc.local"; then
        print -u2 '警告: _zshrc.local の読み込みが失敗しました。'
    fi
fi
