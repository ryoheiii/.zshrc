## コマンドがあるか調べる (以降のガードで使う。PATH 上の実行ファイルだけを見て、alias・関数は数えない)
# WSL の Windows 側の PATH (/mnt/c など) は探さない。探すと無いコマンド 1 つにつき 0.1 秒前後かかる
# 判定は起動時の 1 回だけなので、後から入れたツールは新しいシェル (か zns) で有効になる
function __zshrc_has() {
    local d
    for d in ${path:#/mnt/[a-z]/*}; do
        [[ -f $d/$1 && -x $d/$1 ]] && return 0
    done
    return 1
}

## 日本語utf-8
export LANG=ja_JP.UTF-8

### .local 関連
