# 上方向へcdする
function up() {
    to=$(perl -le '$p=$ENV{PWD}."/";$d="/".$ARGV[0]."/";$r=rindex($p,$d);$r>=0 && print substr($p, 0, $r+length($d))' $1)
    if [ "$to" = "" ]; then
        echo "no such file or directory: $1" 1>&2
        return 1
    fi
    cd $to
}

# 上へ移動する
function cdup() {
    cd ..
    zle reset-prompt
}

## 戻る
## ↑を少し変えただけ
function cdback() {
    popd
    zle reset-prompt
}

# nautilusでフォルダ開く (nautilus がある場合だけ)
if __zshrc_has nautilus; then
    function naop() {
        if [ "$#" = "0" ]; then
            nautilus .
        else
            for d in $@
            do
                echo "nautilus $d"
                nautilus $d
            done
        fi
    }
fi


